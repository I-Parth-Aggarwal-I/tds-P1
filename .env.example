# From @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=

# From aipipe.org/login (sign in with your student email)
AIPIPE_TOKEN=

# Public raw URL where run.jsonl will be reachable, e.g.
# https://raw.githubusercontent.com/YOUR_USERNAME/YOUR_REPO/main/run.jsonl
LOG_URL=

# GitHub personal access token used to push run.jsonl via the Contents API
# (no git CLI / SSH key needed on the host). Create a fine-grained token
# scoped to just this repo, with Contents: Read and write.
GITHUB_TOKEN=

# "YOUR_USERNAME/YOUR_REPO"
GITHUB_REPO=

# Optional — path of the log file inside the repo (default: run.jsonl)
GITHUB_LOG_PATH=

# Optional — branch to push to (default: the repo's default branch)
GITHUB_BRANCH=

# Optional — defaults to gpt-5-mini if unset. Check aipipe.org/playground
# for the current list of available model names.
AIPIPE_MODEL=
